# ───────────── ExploreMate V2 — server configuration ─────────────
# Copy this file to ".env" and fill in what you need.

PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas free tier works great).
# Leave EMPTY to use the built-in local database (stored in server/.data) —
# handy for trying the app with zero setup.
MONGODB_URL=

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origin for the API (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# ───────────── AI provider (optional but recommended) ─────────────
# Without a key the app still works using a built-in planner that uses
# real nearby places from Wikipedia + live weather rules.
#
# Option A — Google Gemini (has a FREE tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
#
# Option B — OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
#
# Force a provider: auto | gemini | openai | local
AI_PROVIDER=auto

# Weather (Open-Meteo), maps (OpenStreetMap) and place info (Wikipedia)
# need NO API keys.
